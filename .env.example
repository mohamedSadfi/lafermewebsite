# Mailgun — used by /api/reservation to send booking emails.
# Sign up at https://www.mailgun.com/, verify a sending domain,
# then drop these values in (real values live in Netlify dashboard,
# never commit a real .env).

# Private API key from Mailgun → Settings → API security → "Sending API key"
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The verified sending domain (e.g. mg.lafermetunisosuisse.com)
MAILGUN_DOMAIN=mg.example.com

# "us" or "eu" — pick the region your Mailgun account is in
MAILGUN_REGION=eu

# From address — must match your verified domain
MAILGUN_FROM="La Ferme Tuniso-Suisse <no-reply@mg.example.com>"

# Where reservation requests get delivered
MAILGUN_TO=infos@lafermetunisosuisse.com
