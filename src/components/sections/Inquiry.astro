---
import SectionLabel from "~/components/ui/SectionLabel.astro";
import InquiryForm from "~/components/islands/InquiryForm";
---

<section
  id="demande"
  class="relative border-t border-hairline scroll-mt-20 bg-bg"
>
  <div class="container-editorial py-24 md:py-32">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5 md:sticky md:top-28 md:self-start">
        <SectionLabel number="07" label="Une demande" />
        <h2
          class="mt-8 font-serif text-4xl leading-[1.1] sm:text-5xl md:text-6xl"
        >
          Un événement,<br />
          <span class="italic font-light">un grand groupe ?</span>
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-soft">
          Mariage, anniversaire, séminaire d'entreprise, réunion de
          famille de 20 ou 200 personnes, commande pour un hôtel…
          écrivez-nous l'essentiel et nous revenons vers vous très vite.
        </p>
        <p class="mt-8 text-sm italic text-ink-soft">
          Pour une simple réservation de table, un coup de fil est plus
          rapide — voir{" "}
          <a
            href="#reserver"
            class="text-primary underline underline-offset-4"
          >
            la section Réserver
          </a>
          .
        </p>
      </div>

      <div class="md:col-span-7">
        <InquiryForm client:visible />
      </div>
    </div>
  </div>
</section>
