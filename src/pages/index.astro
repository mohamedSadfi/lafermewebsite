---
import Base from "~/layouts/Base.astro";
import Hero from "~/components/sections/Hero.astro";
import Story from "~/components/sections/Story.astro";
import Restaurant from "~/components/sections/Restaurant.astro";
import Events from "~/components/sections/Events.astro";
import Visit from "~/components/sections/Visit.astro";
import SectionLabel from "~/components/ui/SectionLabel.astro";
---

<Base>
  <Hero />
  <Story />

  <!-- Market — built in Phase 5 -->
  <section
    id="marche"
    class="relative border-t border-hairline scroll-mt-20"
  >
    <div class="container-editorial py-24 md:py-32">
      <SectionLabel number="02" label="Le marché" />
      <h2 class="mt-6 font-serif text-4xl sm:text-5xl">Marché — bientôt</h2>
    </div>
  </section>

  <Restaurant />
  <Events />
  <Visit />

  <!-- Reservation — built in Phase 6 -->
  <section
    id="reserver"
    class="relative border-t border-hairline scroll-mt-20"
  >
    <div class="container-editorial py-24 md:py-32">
      <SectionLabel number="06" label="Réserver" />
      <h2 class="mt-6 font-serif text-4xl sm:text-5xl">Réservation — bientôt</h2>
    </div>
  </section>
</Base>
